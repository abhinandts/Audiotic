<main class="main">
   
   <body onload="startTimer()">
      <section class="pt-100 pb-100">
         <div class="container">
            <div class="row">
               <div class="col-lg-5 m-auto">
                  <div class="login_wrap widget-taber-content p-30 background-white border-radius-5">
                     <div class="padding_eight_all bg-white">
                        <div class="heading_s1">
                           <h3 class="mb-30">
                              Verify your OTP
                           </h3>
                        </div>
                        <p class="mb-50 font-sm">

                                 The Mobile API Gateway generates time-sensitive One-Time Passwords to
                                 support two-factor authentication.The OTP is a securely generated numeric
                                 or alphanumeric string of characters that authenticates a user for a single
                                 transaction.
                        </p>
                        <div class="form-group">
                           <label class="form-label" for="otp-container">
                              Enter your 4-digit OTP
                           </label>
                           <div id="otp-container" class="d-flex justify-content-center gap-2 mb-3">
                              <input type="tel" class="form-control text-center otp-input" maxlength="1">
                              <input type="tel" class="form-control text-center otp-input" maxlength="1">
                              <input type="tel" class="form-control text-center otp-input" maxlength="1">
                              <input type="tel" class="form-control text-center otp-input" maxlength="1">
                           </div>
                           <p id="otpError" style="color: crimson; font-size: 14px; text-align: center;">
                           </p>
                        </div>
                        <div class="form-group text-center">
                           <button type="button" id="submitOtpBtn" class="btn btn-fill-out btn-block hover-up"
                           onclick="verifyOtp()" name="login" disabled>
                              Submit OTP
                           </button>
                        </div>
                        <div class="divider-text-center mt-15 mb-15">
                           <span>
                              or
                           </span>
                        </div>
                        <ul class="btn-login list_none text-center mb-15">
                           <li>
                              <div>
                                 You can request for new OTP in
                                 <span id="timmer">
                                    now
                                    <span>
                              </div>
                           </li>
                           <li>
                              <button onclick="resendOtp()" id="resend" disabled>
                                 Resend OTP
                              </button>
                           </li>
                        </ul>
                     </div>
                  </div>
               </div>
            </div>
      </section>
</main>
<script src="/scripts/otpPage.js"></script>